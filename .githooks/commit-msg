#!/bin/sh
# Conventional Commits. The release job in ci.yml derives the version bump and
# the changelog from these subjects (.github/release.sh); pr-title.yml runs this
# same check on PR titles, since a squash merge commits the title.
subject=$(head -n1 "$1")
printf '%s\n' "$subject" | grep -Eq \
  '^((feat|fix|perf|refactor|docs|test|build|ci|chore|style|revert)(\([^)]+\))?!?: .+|(Merge|Revert|fixup!|squash!|amend!) )' &&
  exit 0

cat >&2 <<EOF
Not a Conventional Commit: $subject

  type(scope)!: description     scope and ! are optional; ! marks a breaking change

  feat, fix, perf    release and land in the changelog
  refactor docs test build ci chore style revert    do not
EOF
exit 1
